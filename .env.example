# Telegram-бот владельца (создать у @BotFather)
OWNER_BOT_TOKEN=

# LLM (OpenAI-совместимый API; по умолчанию OpenRouter)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# Секрет для шифрования токенов каналов (сгенерируйте: openssl rand -hex 32)
APP_SECRET=change-me

# HTTP
HTTP_ADDR=:8080

# Для локального запуска без Docker
DATABASE_URL=postgres://aiinbox:aiinbox@localhost:5432/aiinbox?sslmode=disable
